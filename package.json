{
  "name": "@5mts/canopy",
  "version": "0.3.0",
  "description": "A lightweight toolkit for customizing the styling and presentation of Grove sites",
  "type": "module",
  "sass": "_index.scss",
  "main": "_index.scss",
  "exports": {
    ".":                 { "sass": "./_index.scss" },
    "./patterns":        { "sass": "./patterns/_index.scss" },
    "./patterns.scss":   { "sass": "./patterns/_index.scss" },
    "./selectors.js":    "./selectors.js",
    "./ready.js":        "./ready.js",
    "./relocate.js":     "./relocate.js",
    "./disclosure.js":   "./disclosure.js",
    "./_selectors.scss": "./_selectors.scss",
    "./_layout.scss":    "./_layout.scss"
  },
  "files": [
    "_index.scss",
    "_selectors.scss",
    "_layout.scss",
    "patterns/",
    "selectors.js",
    "ready.js",
    "relocate.js",
    "disclosure.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:selectors": "node scripts/generate-selectors-js.mjs",
    "prepublishOnly":  "npm run build:selectors"
  },
  "license": "MIT",
  "keywords": [
    "grove",
    "sass",
    "scss",
    "adapter",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  }
}

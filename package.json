{
  "name": "@5mts/canopy",
  "version": "0.2.0",
  "description": "Sass adapter for NPR Grove — maps Grove selectors to semantic keys so themes don't hard-code class names.",
  "type": "module",
  "sass": "_index.scss",
  "main": "_index.scss",
  "exports": {
    ".":                 { "sass": "./_index.scss" },
    "./selectors.js":    "./selectors.js",
    "./ready.js":        "./ready.js",
    "./_selectors.scss": "./_selectors.scss",
    "./_layout.scss":    "./_layout.scss"
  },
  "files": [
    "_index.scss",
    "_selectors.scss",
    "_layout.scss",
    "selectors.js",
    "ready.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:selectors": "node scripts/generate-selectors-js.mjs",
    "prepublishOnly":  "npm run build:selectors"
  },
  "license": "MIT",
  "keywords": [
    "grove",
    "sass",
    "scss",
    "adapter",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  }
}
